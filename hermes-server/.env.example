# ─── Hermes Agent Server ──────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Usage: cp .env.example .env && nano .env

# ── AI Provider ──────────────────────────────────────────────────────────────
# "claude" (default) or "openai"
AI_PROVIDER=claude

# ── API Keys (only the one you use needs to be set) ──────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# ── Model overrides (optional) ───────────────────────────────────────────────
# CLAUDE_MODEL=claude-opus-4-7-20251101
# OPENAI_MODEL=gpt-4o

# ── Filesystem ───────────────────────────────────────────────────────────────
# Defaults to ~/agent-os — override if you moved the directory
# AGENT_OS_HOME=/root/agent-os
