# Copy to .env and fill in your keys

# "claude" or "openai"
AI_PROVIDER=claude

# Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI
OPENAI_API_KEY=sk-...

# Optional model overrides
# CLAUDE_MODEL=claude-opus-4-7-20251101
# OPENAI_MODEL=gpt-4o

# Optional: override agent-os root
# AGENT_OS_HOME=/root/agent-os
